# Build stage
FROM golang:1.25.13-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -o /app/client ./examples/client

# Runtime stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates

WORKDIR /root/

COPY --from=builder /app/client .

ENV SERVER_ADDR=server:8080

CMD ["sh", "-c", "./client -addr ${SERVER_ADDR}"]
